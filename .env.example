# Local development only: the Vite dev server proxies /api to this IRIS instance.
# IRIS_PORT is the instance's web server port: 52780 for the Docker container
# (docker-compose.yml maps it there), or your local instance's own port
# (52773 is the IRIS default).
IRIS_HOST=localhost
IRIS_PORT=52773
# Optional. When set, the dev proxy adds Basic auth to requests that carry no
# credentials of their own. Leave unset to test the portal's own sign-in.
# IRIS_USERNAME=_SYSTEM
# IRIS_PASSWORD=SYS
# Dev server only: skip the sign-in screen, for an instance whose /api/admin
# allows only Unauthenticated access. Ignored by `npm run build`.
# VITE_SKIP_SIGNIN=1
