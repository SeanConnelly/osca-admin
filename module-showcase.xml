			<Packaging>module</Packaging>
			<SystemRequirements Version=">=2026.2"/>

			<Dependencies>
				<ModuleReference>
					<Name>osca-portal</Name>
					<Version>0.1.0</Version>
				</ModuleReference>
			</Dependencies>

			<!-- Separate from the main module: its sources live in iris-showcase/, never in iris/,
			     and module.xml does not reference this module. -->
			<SourcesRoot>iris-showcase</SourcesRoot>
			<Resource Name="OscaShowcase.PKG"/>

			<Invoke Class="OscaShowcase.Installer" Method="CreateApp">
				<Arg>${namespace}</Arg>
			</Invoke>
			<!-- On uninstall, remove the web application (only if it is this module's). -->
			<Invoke Class="OscaShowcase.Installer" Method="RemoveApp" Phase="Unconfigure" When="Before"></Invoke>
		</Module>
	</Document>
